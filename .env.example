# --- Required ---
# Supabase project URL (NOT the database connection string)
FH_SUPABASE_URL=https://rjzlehedbbcahwmfmdig.supabase.co
# Service role key — used for ohlcv_cache upserts. NEVER expose to the client.
FH_SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ---
# Comma-separated origins allowed for CORS. Defaults to localhost:3000 + fatihhekimoglu.com.
FH_CORS_ORIGINS=http://localhost:3000,https://fatihhekimoglu.com

# Disk cache root (local dev only; not used in Fly VM)
FH_DISKCACHE_DIR=.yfcache

# Log level
FH_LOG_LEVEL=INFO

# Polygon.io Starter — for survivorship-bias-free EOD
POLYGON_API_KEY=
